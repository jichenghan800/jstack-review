{
  "name": "jstack-ai-analyzer",
  "version": "2.0.0",
  "description": "AI-powered Java thread dump analyzer using AutoGen & AWS Bedrock",
  "main": "autogen-bedrock-server.js",
  "scripts": {
    "start": "concurrently \"python3 -m http.server 8080\" \"node autogen-bedrock-server.js\"",
    "web": "python3 -m http.server 8080",
    "autogen": "node autogen-bedrock-server.js",
    "bedrock": "node bedrock-test-server.js",
    "dev": "nodemon autogen-bedrock-server.js",
    "test": "node test-bedrock.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.873.0",
    "@aws-sdk/client-bedrock-runtime": "^3.873.0",
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "java",
    "thread-dump",
    "ai",
    "autogen",
    "aws-bedrock",
    "claude",
    "performance-analysis"
  ],
  "author": "jichenghan800",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jichenghan800/jstack-review.git"
  },
  "homepage": "https://jichenghan800.github.io/jstack-review/"
}
